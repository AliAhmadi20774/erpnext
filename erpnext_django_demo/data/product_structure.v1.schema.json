{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp-prototype.local/schemas/product-structure.v1.schema.json",
  "title": "Versioned Product Structure",
  "description": "Portable item master and multi-level bill of materials dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "items", "boms"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "description"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 80},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": "string", "maxLength": 500}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    },
    "boms": {
      "type": "array",
      "items": {"$ref": "#/$defs/bom"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "name", "category", "unit", "sale_price", "purchase_price", "reorder_level", "is_active"],
      "properties": {
        "sku": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,39}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "category": {"type": "string", "minLength": 1, "maxLength": 80},
        "unit": {"type": "string", "minLength": 1, "maxLength": 30},
        "sale_price": {"type": "integer", "minimum": 0},
        "purchase_price": {"type": "integer", "minimum": 0},
        "reorder_level": {"type": "integer", "minimum": 0},
        "lead_time_days": {"type": "integer", "minimum": 0, "maximum": 3650},
        "opening_stock": {"type": "integer", "minimum": 0},
        "is_active": {"type": "boolean"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_sku", "quantity", "scrap_percent", "sequence", "notes"],
      "properties": {
        "item_sku": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,39}$"},
        "quantity": {"type": "string", "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,3})?$"},
        "scrap_percent": {"type": "string", "pattern": "^(100(\\.0{1,2})?|[0-9]{1,2}(\\.[0-9]{1,2})?)$"},
        "sequence": {"type": "integer", "minimum": 0},
        "notes": {"type": "string", "maxLength": 255}
      }
    },
    "bom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "product_sku", "version", "output_quantity", "status", "notes", "components"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 50},
        "manufacturing_days": {"type": "integer", "minimum": 0, "maximum": 3650},
        "product_sku": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,39}$"},
        "version": {"type": "integer", "minimum": 1},
        "output_quantity": {"type": "string", "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,3})?$"},
        "status": {"enum": ["draft", "active", "obsolete"]},
        "notes": {"type": "string"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/component"}
        }
      }
    }
  }
}
